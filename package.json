{
  "name": "bb-plugin-pins",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Horizontal niri-style strip of pinned BB threads.",
  "type": "module",
  "engines": {
    "bb": ">=0.39 <1.0.0",
    "bbPluginSdk": ">=0.4.14"
  },
  "bb": {
