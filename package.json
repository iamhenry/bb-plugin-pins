  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test order.test.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.24",
